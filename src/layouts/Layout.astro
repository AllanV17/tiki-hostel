---
import '../styles/global.css';
import { withBase } from '../utils/withBase';
import type { Language, SiteContent } from '../i18n';
import { getLocalizedHref, type Page } from '../i18n/routes';
import { ClientRouter } from 'astro:transitions';

interface Props {
	content: SiteContent;
	language: Language;
	page: Page | null;
	title?: string;
	description?: string;
}

const {
	content,
	language,
	page,
	title = content.layout.title,
	description = content.layout.description,
} = Astro.props;
const site = Astro.site ?? Astro.url;
// Canonical and hreflang URLs must remain absolute across both language routes and the site base.
const absoluteHref = (targetLanguage: Language) =>
	page === null ? undefined : new URL(getLocalizedHref(page, targetLanguage), site).href;
const esHref = absoluteHref('es');
const enHref = absoluteHref('en');
const canonicalHref = language === 'es' ? esHref : enHref;
---

<!doctype html>
<html lang={language}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="icon" href={withBase('/favicon.ico')} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{page !== null && <meta property="og:url" content={canonicalHref} />}
		<meta property="og:locale" content={language === 'es' ? 'es_NI' : 'en_US'} />
		<meta property="og:locale:alternate" content={language === 'es' ? 'en_US' : 'es_NI'} />
		<meta property="og:site_name" content={content.layout.title} />
		{(page === null || import.meta.env.PUBLIC_ALLOW_INDEXING !== 'true') && <meta name="robots" content="noindex, follow" />}
		<meta name="theme-color" content="#faf6f0" />
		{page !== null && <>
			<link rel="canonical" href={canonicalHref} />
			<link rel="alternate" hreflang="es" href={esHref} />
			<link rel="alternate" hreflang="en" href={enHref} />
			<link rel="alternate" hreflang="x-default" href={esHref} />
		</>}
		<link rel="stylesheet" href={withBase('/fonts/fonts.css')} />
		<title>{title}</title>
		<ClientRouter fallback="swap" />
	</head>
	<body>
		<a class="skip-link" href="#main-content">{content.shared.nav.skipToContent}</a>
		<slot />
		<script>
			import '../scripts/not-found';
			import { initScrollReveals } from '../scripts/reveal';
			let revealedPage: Element | null = null;
			let stopReveals: (() => void) | undefined;
			function revealPage() {
				const main = document.querySelector('main');
				if (!main || main === revealedPage) return;
				stopReveals?.();
				revealedPage = main;
				stopReveals = initScrollReveals();
			}
			document.addEventListener('astro:page-load', revealPage);
			revealPage();
		</script>
	</body>
</html>
