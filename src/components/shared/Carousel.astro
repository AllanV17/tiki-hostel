---
import '../../styles/carousel.css';

export interface CarouselImage {
	src?: string;
	alt: string;
	placeholderLabel: string;
}

interface Props {
	images: CarouselImage[];
	label: string;
	variant: 'wide' | 'split' | 'gallery' | 'rooms-first' | 'spaces';
	controlsLayout?: 'reversed' | 'stacked-center';
	reveal?: 'in';
	labels: {
		previous: string;
		next: string;
		position: string;
		of: string;
		placeholderSelect: string;
		placeholderPending: string;
	};
}

const { images, label, variant, controlsLayout, reveal, labels } = Astro.props;
---

<div class:list={['carousel', `carousel--${variant}`, { 'carousel--controls-reversed': controlsLayout === 'reversed', 'carousel--controls-stacked-center': controlsLayout === 'stacked-center' }]} role="region" aria-roledescription="carousel" aria-label={label} data-carousel data-reveal={reveal}>
	<div class="carousel__track" tabindex="0" data-carousel-track>
		{images.map((image, index) => (
			<div class:list={['carousel__slide', { 'is-active': index === 0 }]} data-carousel-slide>
				{variant === 'rooms-first' || variant === 'spaces' ? (
					image.src ? (
						<img class="carousel__image" src={image.src} alt={image.alt} loading="lazy" />
					) : (
						<div class:list={['hostel-image', { 'hostel-image--secondary': index % 3 === 1, 'hostel-image--detail': index % 3 === 2 }]} role="img" aria-label={`${image.placeholderLabel}. ${labels.placeholderSelect}`}>
							<span class="hostel-image__label" aria-hidden="true">{image.placeholderLabel}</span>
							<span class="hostel-image__pending" aria-hidden="true">{labels.placeholderPending}</span>
						</div>
					)
				) : variant === 'gallery' ? (
					<div class:list={['carousel__gallery-panels', `carousel__gallery-panels--${Math.min(3, images.length - index)}`]}>
						{images.slice(index, index + 3).map((panel, panelIndex) => (
							<div class="carousel__gallery-panel" aria-hidden={panelIndex > 0 ? 'true' : undefined}>
								{panel.src ? (
									<img class="carousel__image" src={panel.src} alt={panelIndex === 0 ? panel.alt : ''} loading="lazy" />
								) : (
									<div class:list={['activity-image-placeholder', { 'activity-image-placeholder--dark': panelIndex === 1 }]} role="img" aria-label={`${panel.placeholderLabel}. ${labels.placeholderSelect}`}>
										<span class="activity-image-placeholder__label" aria-hidden="true">{panel.placeholderLabel}</span>
										<span class="activity-image-placeholder__pending" aria-hidden="true">{labels.placeholderPending}</span>
									</div>
								)}
							</div>
						))}
					</div>
				) : image.src ? (
					<img class="carousel__image" src={image.src} alt={image.alt} loading="lazy" />
				) : (
					<div class="activity-image-placeholder" role="img" aria-label={`${image.placeholderLabel}. ${labels.placeholderSelect}`}>
						<span class="activity-image-placeholder__label" aria-hidden="true">{image.placeholderLabel}</span>
						<span class="activity-image-placeholder__pending" aria-hidden="true">{labels.placeholderPending}</span>
					</div>
				)}
			</div>
		))}
	</div>
	<div class="carousel__controls">
		<span class="carousel__steps" role="img" aria-label={`${labels.position} 1 ${labels.of} ${images.length}`} data-carousel-steps data-position={labels.position} data-of={labels.of}>
			{images.map((_, index) => <span class:list={['carousel__step', { 'is-active': index === 0 }]} data-carousel-step aria-hidden="true" />)}
		</span>
		<button class="carousel__button" type="button" aria-label={labels.previous} data-carousel-previous disabled><span aria-hidden="true">←</span></button>
		<button class="carousel__button" type="button" aria-label={labels.next} data-carousel-next disabled={images.length < 2}><span aria-hidden="true">→</span></button>
	</div>
</div>

<script>
	import { cleanupCarousels, initCarousels } from '../../scripts/carousel';
	document.addEventListener('astro:before-swap', cleanupCarousels);
	document.addEventListener('astro:page-load', initCarousels);
	initCarousels();
</script>
