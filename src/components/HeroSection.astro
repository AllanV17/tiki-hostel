---
import type { SiteContent } from '../i18n';
interface Props {
	content: SiteContent;
}
import { Image } from 'astro:assets';
// Replace this provisional image only after the final hero photography is approved.
import heroImage from '../assets/hero/hero-provisional.png';
const { content } = Astro.props;
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
	<div class="hero__media">
		<Image
			src={heroImage}
			alt=""
			class="hero__image"
			widths={[480, 768, 1024, 1440, 1672]}
			sizes="100vw"
			format="webp"
			loading="eager"
			fetchpriority="high"
		/>
	</div>
	<div class="hero__content container">
		<div class="hero__intro">
			<div class="hero__heading">
				<p class="eyebrow">{content.home.hero.eyebrow}</p>
				<h1 class="display-title" id="hero-title">{content.home.hero.title}</h1>
			</div>
			<p class="hero__description">{content.home.hero.description}</p>
			<a
				class="button hero__cta"
				href="#contacto"
				data-link-placeholder
				aria-label={content.shared.nav.directPending}
				>{content.shared.nav.direct}</a
			>
		</div>
	</div>
</section>
