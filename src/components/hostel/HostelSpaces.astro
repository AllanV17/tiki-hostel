---
import type { SiteContent } from '../../i18n';
interface Props {
	content: SiteContent;
}
import HostelImagePlaceholder from './HostelImagePlaceholder.astro';
const { content } = Astro.props;
---

<section class="hostel-spaces" aria-labelledby="hostel-spaces-title">
	<div class="hostel-container">
		<header class="hostel-section-head hostel-spaces__heading">
			<div>
				<p class="hostel-eyebrow">{content.hostel.spaces.eyebrow}</p>
				<h2 id="hostel-spaces-title">
					{content.hostel.spaces.title[0]}<br class="desktop-break" />{
						content.hostel.spaces.title[1]
					}
				</h2>
			</div>
			<p>{content.hostel.spaces.description}</p>
		</header>
		<div class="hostel-spaces__grid">
			<article
				class="hostel-space hostel-space--primary"
				aria-labelledby="hostel-space-first-title"
			>
				<HostelImagePlaceholder
					content={content}
					label={content.hostel.spaces.firstImage}
					className="hostel-space__main-image"
				/>
				<div class="hostel-space__caption">
					<div>
						<p class="hostel-space__index">
							<span>01</span><span>{content.hostel.spaces.firstIndex}</span>
						</p>
						<h3 id="hostel-space-first-title">
							{content.hostel.spaces.firstTitle}
						</h3>
					</div>
					<p>{content.hostel.spaces.firstDescription}</p>
				</div>
			</article>
			<article
				class="hostel-space hostel-space--secondary"
				aria-labelledby="hostel-space-second-title"
			>
				<div class="hostel-space__previews">
					<HostelImagePlaceholder
						content={content}
						label={content.hostel.spaces.secondImages[0]}
						variant="secondary"
					/>
					<HostelImagePlaceholder
						content={content}
						label={content.hostel.spaces.secondImages[1]}
						variant="detail"
					/>
				</div>
				<p class="hostel-space__index">
					<span>02</span><span>{content.hostel.spaces.secondIndex}</span>
				</p>
				<h3 id="hostel-space-second-title">
					{content.hostel.spaces.secondTitle}
				</h3>
				<p>{content.hostel.spaces.secondDescription}</p>
			</article>
		</div>
	</div>
</section>
