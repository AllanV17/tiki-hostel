---
import { getImage } from 'astro:assets';
import signPhoto from '../../assets/hostel/habitaciones-letrero-tiki.jpg';
import hammockPhoto from '../../assets/home/detalle-hostal.webp';
import redBedPhoto from '../../assets/hostel/habitaciones-cama-mosquitero-rojo.png';
import bunkPhoto from '../../assets/hostel/habitaciones-litera.png';
import purpleBedPhoto from '../../assets/hostel/habitaciones-cama-mosquitero-morado.png';
import ranchoPhoto from '../../assets/hostel/habitaciones-rancho-mesas.webp';
import type { Language, SiteContent } from '../../i18n';
interface Props {
	content: SiteContent;
	language: Language;
}
import Carousel from '../shared/Carousel.astro';
const { content, language } = Astro.props;
const photos = [
	[signPhoto, 'Autobús amarillo junto al letrero de Tiki Hostel', 'Yellow bus beside the Tiki Hostel sign'],
	[ranchoPhoto, 'Mesas de madera bajo el rancho de techo de palma', 'Wooden tables beneath the palm-roofed rancho'],
	[hammockPhoto, 'Hamaca y asientos en un espacio común del hostal', 'Hammock and chairs in a hostel common area'],
	[redBedPhoto, 'Cama doble con mosquitero rojo en una habitación', 'Double bed with a red mosquito net in a room'],
	[bunkPhoto, 'Litera de madera en una habitación del hostal', 'Wooden bunk bed in a hostel room'],
	[purpleBedPhoto, 'Cama doble con mosquitero morado en una habitación', 'Double bed with a purple mosquito net in a room'],
] as const;
const firstImages = await Promise.all(photos.map(async ([photo, altEs, altEn], index) => ({
	src: (await getImage({ src: photo, width: Math.min(photo.width, 1200), format: photo.format })).src,
	alt: language === 'es' ? altEs : altEn,
	placeholderLabel: content.hostel.rooms.firstImages[index],
})));
---

<section class="hostel-rooms" aria-labelledby="hostel-rooms-title">
	<div class="hostel-container">
		<div class="hostel-section-head hostel-rooms__heading">
			<header data-reveal="up">
				<p class="hostel-eyebrow">{content.hostel.rooms.eyebrow}</p>
				<h2 id="hostel-rooms-title">{content.hostel.rooms.title}</h2>
			</header>
			<div class="hostel-room__intro" data-reveal="up">
				<p class="hostel-room__note">{content.hostel.rooms.firstNote}</p>
			</div>
		</div>
		<Carousel
			reveal="in"
			images={firstImages}
			label={content.hostel.rooms.firstCarousel.label}
			variant="spaces"
			controlsLayout="stacked-center"
			editorialProgress
			labels={{
				previous: content.hostel.rooms.firstCarousel.previous,
				next: content.hostel.rooms.firstCarousel.next,
				position: content.hostel.rooms.firstCarousel.position,
				of: content.hostel.rooms.firstCarousel.of,
				placeholderSelect: content.shared.placeholder.photoSelect,
				placeholderPending: content.shared.placeholder.photoToSelect,
			}}
		/>
	</div>
</section>
