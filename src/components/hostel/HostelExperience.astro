---
import { Image } from 'astro:assets';
import experiencePhoto from '../../assets/hostel/experiencia-grupo-laguna.jpg';
import type { Language, SiteContent } from '../../i18n';
interface Props {
	content: SiteContent;
	language: Language;
}
const { content, language } = Astro.props;
---

<section class="hostel-experience" aria-labelledby="hostel-experience-title">
	<div class="hostel-container">
		<header class="hostel-section-head hostel-experience__heading" data-reveal="up">
			<div>
				<p class="hostel-eyebrow">{content.hostel.experience.eyebrow}</p>
				<h2 id="hostel-experience-title">
					{content.hostel.experience.title[0]}<br class="desktop-break" />{
						content.hostel.experience.title[1]
					}
				</h2>
			</div>
			<p>{content.hostel.experience.description}</p>
		</header>
		<div class="hostel-experience__composition">
			<Image
				src={experiencePhoto}
				alt={language === 'es' ? 'Grupo de viajeros reunido junto al agua al atardecer' : 'Group of travelers gathered by the water at sunset'}
				class="hostel-experience__image"
				format="jpeg"
				loading="lazy"
				data-reveal="in"
			/>
			<div class="hostel-experience__editorial" data-reveal="up">
				<p class="hostel-eyebrow">{content.hostel.experience.editorialEyebrow}</p>
				<h3>{content.hostel.experience.editorialTitle}</h3>
				{content.hostel.experience.editorialParagraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</div>
	</div>
</section>
