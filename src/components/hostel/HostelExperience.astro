---
import { Image } from 'astro:assets';
import experiencePhoto from '../../assets/hostel/experiencia-grupo-laguna.jpg';
import type { Language, SiteContent } from '../../i18n';
interface Props {
	content: SiteContent;
	language: Language;
}
const { content, language } = Astro.props;
---

<section class="hostel-experience" aria-labelledby="hostel-experience-title">
	<div class="hostel-container hostel-experience__composition">
		<header class="hostel-experience__heading" data-reveal="up">
			<p class="hostel-eyebrow">{content.hostel.experience.eyebrow}</p>
			<h2 id="hostel-experience-title">{content.hostel.experience.title}</h2>
		</header>
		<Image
			src={experiencePhoto}
			alt={language === 'es' ? 'Grupo de viajeros reunido junto al agua al atardecer' : 'Group of travelers gathered by the water at sunset'}
			class="hostel-experience__image"
			format="jpeg"
			loading="lazy"
			data-reveal="in"
		/>
		<p class="hostel-experience__body" data-reveal="up">{content.hostel.experience.description}</p>
	</div>
</section>
