---
import { Image } from 'astro:assets';
import heroPhoto from '../../assets/hostel/hero-hostal.png';
import mobileHeroPhoto from '../../assets/hostel/hostal-hero-mobile.webp';
import type { Language, SiteContent } from '../../i18n';
interface Props {
	content: SiteContent;
	language: Language;
}
const { content, language } = Astro.props;
---

<section class="hostel-hero" aria-labelledby="hostel-title">
	<div class="hostel-container">
		<div class="hostel-hero__intro">
			<div>
				<p class="hostel-eyebrow hostel-eyebrow--green">
					{content.hostel.hero.eyebrow}
				</p>
				<h1 id="hostel-title">{content.hostel.hero.title}</h1>
			</div>
			<p>{content.hostel.hero.description}</p>
		</div>
		<picture class="hostel-hero__picture">
			<source media="(max-width: 1100px)" srcset={encodeURI(mobileHeroPhoto.src)} type="image/webp" />
			<Image
				src={heroPhoto}
				alt={language === 'es' ? 'Huésped leyendo mientras descansa en una hamaca en Tiki Hostel' : 'Guest reading while relaxing in a hammock at Tiki Hostel'}
				class="hostel-hero__image"
				format="png"
				width={1600}
				loading="eager"
				fetchpriority="high"
			/>
		</picture>
	</div>
</section>
