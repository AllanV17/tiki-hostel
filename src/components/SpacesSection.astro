---
import type { SiteContent } from '../i18n';
interface Props {
	content: SiteContent;
}
import MediaPlaceholder from './MediaPlaceholder.astro';
const { content } = Astro.props;

const variants = ['olive', 'stone', 'clay'] as const;
---

<section
	class="spaces section-space"
	id="alojamientos"
	aria-labelledby="spaces-title"
>
	<div class="container">
		<div class="spaces__heading">
			<div class="section-heading">
				<p class="eyebrow eyebrow--blue">{content.home.spaces.eyebrow}</p>
				<h2 class="section-title" id="spaces-title">
					{content.home.spaces.title}
				</h2>
			</div>
		</div>
		<div class="spaces-grid">
			{
				content.home.spaces.cards.map((space, index) => (
					<article class="space-card provisional-copy">
						<MediaPlaceholder
							content={content}
							label={space.image}
							variant={variants[index]}
							className="space-card__photo"
						/>
						<div class="space-card__body">
							<h3>{space.title}</h3>
							<p>{space.description}</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
