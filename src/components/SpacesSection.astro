---
import type { SiteContent } from '../i18n';
interface Props {
	content: SiteContent;
}
import { Image } from 'astro:assets';
import cabinImage from '../assets/home/cabana-privada.webp';
import dormImage from '../assets/home/dormitorio-compartido.jpg';
import kitchenImage from '../assets/home/cocina-compartida.jpg';
const { content } = Astro.props;

const images = [cabinImage, dormImage, kitchenImage];
---

<section
	class="spaces section-space"
	id="alojamientos"
	aria-labelledby="spaces-title"
>
	<div class="container">
		<div class="spaces__heading">
			<div class="section-heading" data-reveal="up">
				<p class="eyebrow eyebrow--blue">{content.home.spaces.eyebrow}</p>
				<h2 class="section-title" id="spaces-title">
					{content.home.spaces.title}
				</h2>
			</div>
		</div>
		<div class="spaces-grid" data-reveal-stagger>
			{
				content.home.spaces.cards.map((space, index) => (
					<article class="space-card provisional-copy" data-reveal="up">
						<Image
							src={images[index]}
							format={images[index].format}
							widths={[320, 640, 960]}
							sizes="(max-width: 560px) 100vw, (max-width: 820px) 50vw, 33vw"
							alt={space.imageAlt}
							class="home-photo space-card__photo"
							loading="lazy"
						/>
						<div class="space-card__body">
							<h3>{space.title}</h3>
							<p>{space.description}</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
