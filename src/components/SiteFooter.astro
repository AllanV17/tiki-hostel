---
import type { Language, SiteContent } from '../i18n';
import { Image } from 'astro:assets';
import logo from '../assets/tiki-hostel-logo-blanco.png';
import { getLocalizedHref, type Page } from '../i18n/routes';
import { bookingUrl, instagramUrl, facebookUrl } from '../config/external-links';

interface Props {
	content: SiteContent;
	language: Language;
	activePage: Page | null;
}

const { content, language, activePage } = Astro.props;
const { footer, nav } = content.shared;

// Unconfirmed reservation, social and WhatsApp destinations stay non-navigable until approved.
const reservationUrls: Record<
	'directBooking' | 'airbnb' | 'booking',
	string | null
> = {
	directBooking: null,
	airbnb: null,
	booking: bookingUrl,
};

const reservationMethods = [
	{ key: 'airbnb', label: footer.airbnb, url: reservationUrls.airbnb },
	{ key: 'booking', label: footer.booking, url: reservationUrls.booking },
	{
		key: 'directBooking',
		label: footer.directBooking,
		url: reservationUrls.directBooking,
	},
] as const;

const contactUrls: Record<
	'whatsapp' | 'instagram' | 'facebook',
	string | null
> = {
	whatsapp: null,
	instagram: instagramUrl,
	facebook: facebookUrl,
};

const contactMethods = [
	{ key: 'whatsapp', label: footer.whatsapp, url: contactUrls.whatsapp },
	{ key: 'instagram', label: footer.instagram, url: contactUrls.instagram },
	{ key: 'facebook', label: footer.facebook, url: contactUrls.facebook },
] as const;
---

<footer class="site-footer">
	<div class="container">
		<div class="site-footer__main">
			<div class="site-footer__brand">
				<a
					class="brand brand--footer"
					href={getLocalizedHref('home', language)}
				>
					<span class="site-footer__logo-frame">
						<Image
							src={logo}
							alt={footer.brand}
							class="site-footer__logo"
							loading="lazy"
						/>
					</span>
				</a>
				<p>{content.home.footer.description}</p>
				<p class="site-footer__location">{footer.location}</p>
			</div>

			<nav class="footer-group" aria-label={footer.sectionsLabel}>
				<h2>{footer.navigation}</h2>
				<a
					href={getLocalizedHref('home', language)}
					aria-current={activePage === 'home' ? 'page' : undefined}
					>{nav.home}</a
				>
				<a
					href={getLocalizedHref('hostel', language)}
					aria-current={activePage === 'hostel' ? 'page' : undefined}
					>{nav.hostel}</a
				>
				<a
					href={getLocalizedHref('activities', language)}
					aria-current={activePage === 'activities' ? 'page' : undefined}
					>{nav.activities}</a
				>
				<a
					href={getLocalizedHref('contact', language)}
					aria-current={activePage === 'contact' ? 'page' : undefined}
					>{nav.contact}</a
				>
			</nav>

			<div class="footer-group site-footer__reservations">
				<h2>{footer.reservations}</h2>
				{
					reservationMethods.map(({ key, label, url }) => {
						const Tag = url ? 'a' : 'span';
						return (
							<Tag
								class={`site-footer__contact-button site-footer__contact-button--${key}`}
								href={url ?? undefined}
								target={url ? '_blank' : undefined}
								rel={url ? 'noopener noreferrer' : undefined}
								data-link-placeholder={url ? undefined : ''}
							>
								<span class="site-footer__contact-content">
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
										focusable="false"
									>
										{key === 'directBooking' && <path d="M20 11.5a8 8 0 0 1-8 8 9 9 0 0 1-3.5-.7L4 20l1.2-4.5a9 9 0 0 1-.7-3.5 8 8 0 0 1 15.5-.5Z M8 11.5h8 M8 15h5" />}
										{key === 'airbnb' && <path d="m3 10 9-7 9 7 M5 9v12h14V9 M9 21v-8h6v8" />}
										{key === 'booking' && <path d="M3 18v3 M21 18v3 M3 18h18v-6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6Z M5 10V5h14v5 M8 8h2 M14 8h2" />}
									</svg>
									<span>{label}</span>
								</span>
							</Tag>
						);
					})
				}
			</div>

			<div class="footer-group site-footer__contact">
				<h2>{footer.contact}</h2>
				<div class="site-footer__contact-links">
					{
						contactMethods.map(({ key, label, url }) => {
							const Tag = url ? 'a' : 'button';
							return (
								<Tag
									class={`site-footer__contact-button site-footer__contact-button--${key}`}
									href={url ?? undefined}
									type={url ? undefined : 'button'}
									target={url ? '_blank' : undefined}
									rel={url ? 'noopener noreferrer' : undefined}
									aria-label={label}
									aria-disabled={url ? undefined : 'true'}
									data-link-placeholder={url ? undefined : ''}
								>
									<span class="site-footer__contact-content">
										{key === 'whatsapp' && (
											<svg
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="1.7"
												stroke-linecap="round"
												stroke-linejoin="round"
												aria-hidden="true"
												focusable="false"
											>
												<path d="M20.5 11.8a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.3-4.2a8.5 8.5 0 1 1 15.7-4.5Z" />
												<path d="M8.2 8.2c.5 3.3 3.2 6.2 6.5 7.1l1.5-1.3 1.7.8-.4 1.5c-.3.9-1.3 1.2-2.2 1A11 11 0 0 1 7 9.5c-.2-.9.2-1.8 1.1-2.1l1.4-.4.9 1.8-1.2 1.3" />
											</svg>
										)}
										{key === 'instagram' && (
											<svg
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="1.8"
												stroke-linecap="round"
												stroke-linejoin="round"
												aria-hidden="true"
												focusable="false"
											>
												<rect x="2.5" y="2.5" width="19" height="19" rx="5" />
												<circle cx="12" cy="12" r="4" />
												<circle
													cx="17.7"
													cy="6.3"
													r="1"
													fill="currentColor"
													stroke="none"
												/>
											</svg>
										)}
										{key === 'facebook' && (
											<svg
												viewBox="0 0 24 24"
												fill="currentColor"
												aria-hidden="true"
												focusable="false"
											>
												<path d="M14.1 21v-8.1h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2H8v3.1h2.7V21h3.4Z" />
											</svg>
										)}
										<span class="site-footer__contact-label">{label}</span>
									</span>
								</Tag>
							);
						})
					}
				</div>
			</div>
		</div>
		<div class="site-footer__bottom">
			<p>{footer.copyright}</p>
			<div
				class="site-footer__legal"
				role="group"
				aria-label={footer.legalLabel}
			>
				<span data-link-placeholder>{footer.privacyPolicy}</span>
				<span data-link-placeholder>{footer.cookies}</span>
			</div>
		</div>
	</div>
</footer>
