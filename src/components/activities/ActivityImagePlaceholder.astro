---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
	src?: ImageMetadata;
	alt?: string;
	variant?: 'light' | 'dark';
}
const { src, alt = '', variant = 'light' } = Astro.props;
---

<div class:list={['activity-image-placeholder', `activity-image-placeholder--${variant}`]} aria-hidden={src ? undefined : 'true'}>
	{src && <Image src={src} alt={alt} format="webp" loading="lazy" />}
</div>
