---
import type { SiteContent } from '../../i18n';
import ActivityImagePlaceholder from './ActivityImagePlaceholder.astro';
import kayakImage from '../../assets/activities/tarjeta-kayak-viajero-orilla-arbolada-volcan.png';
import horsebackImage from '../../assets/activities/tarjeta-paseo-a-caballo.png';
import hikingImage from '../../assets/activities/tarjeta-senderismo.png';
interface Props { content: SiteContent; }
const { content } = Astro.props;
const images = [kayakImage, horsebackImage, hikingImage];
---

<section class="activities-routes activities-container" aria-labelledby="activities-routes-title">
	<div class="activities-section-head" data-reveal="up">
		<div>
			<p class="activities-eyebrow">{content.activities.routes.eyebrow}</p>
			<h2 id="activities-routes-title">{content.activities.routes.title}</h2>
		</div>
		<p>{content.activities.routes.description}</p>
	</div>
	<div class="activities-routes__grid" data-reveal-stagger>
		{content.activities.routes.items.map((activity, index) => (
			<article class:list={['activity-card', { 'activity-card--kayak': index === 0 }]} data-reveal="up">
				<ActivityImagePlaceholder src={images[index]} alt={activity.imageAlt} />
				<div class="activity-card__copy">
					<p class="activities-eyebrow">{activity.category}</p>
					<h3>{activity.title}</h3>
					<p>{activity.description}</p>
				</div>
			</article>
		))}
	</div>
</section>
