---
import type { SiteContent } from '../../i18n';
interface Props {
	content: SiteContent;
}
import ActivityImagePlaceholder from './ActivityImagePlaceholder.astro';
const { content } = Astro.props;
---

<section
	class="activities-hero activities-container"
	aria-labelledby="activities-title"
>
	<div class="activities-hero__intro">
		<div>
			<p class="activities-eyebrow activities-eyebrow--green">
				{content.activities.hero.eyebrow}
			</p>
			<h1 id="activities-title">
				{content.activities.hero.title[0]}<br />{
					content.activities.hero.title[1]
				}
			</h1>
		</div>
		<p class="activities-hero__summary">
			{content.activities.hero.description}
		</p>
	</div>
	<div class="activities-hero__visuals">
		<ActivityImagePlaceholder
			content={content}
			label={content.activities.hero.image}
			className="activities-hero__image"
		/>
		<aside
			class="activities-hero__aside"
			aria-label={content.activities.hero.asideLabel}
		>
			<span class="activities-hero__number">03</span>
			<div>
				<h2>{content.activities.hero.asideLabel}</h2>
				<p>{content.activities.hero.aside}</p>
			</div>
		</aside>
	</div>
</section>
