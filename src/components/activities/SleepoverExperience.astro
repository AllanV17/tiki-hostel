---
import type { SiteContent } from '../../i18n';
import { Image } from 'astro:assets';
import maderasImage from '../../assets/activities/volcan-maderas-laguna-crater-vista-aerea.png';
interface Props { content: SiteContent; }
const { content } = Astro.props;
---

<section class="sleepover" aria-labelledby="sleepover-title">
	<div class="sleepover__inner activities-container">
		<div class="sleepover__copy" data-reveal="up">
			<p class="activities-eyebrow">{content.activities.sleepover.eyebrow}</p>
			<h2 id="sleepover-title">{content.activities.sleepover.title}</h2>
			<p>{content.activities.sleepover.description}</p>
		</div>
		<div class="activity-image-placeholder activity-image-placeholder--dark">
			<Image
				src={maderasImage}
				alt={content.activities.sleepover.imageAlt}
				format="webp"
				widths={[400, 640, 960, 1280, 1533]}
				sizes="(max-width: 560px) calc(100vw - 44px), (max-width: 820px) calc(100vw - 64px), (max-width: 1100px) calc((100vw - 136px) * 0.575), (max-width: 1440px) calc((100vw - 232px) * 0.575), 695px"
				loading="lazy"
				decoding="async"
			/>
		</div>
	</div>
</section>
