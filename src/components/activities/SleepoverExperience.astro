---
import type { SiteContent } from '../../i18n';
interface Props {
	content: SiteContent;
}
import ActivityImagePlaceholder from './ActivityImagePlaceholder.astro';
const { content } = Astro.props;
---

<section class="sleepover" aria-labelledby="sleepover-title">
	<div class="sleepover__feature">
		<div class="activities-container">
			<div class="activities-section-head sleepover__feature-heading">
				<div>
					<p class="activities-eyebrow">
						{content.activities.sleepover.eyebrow}
					</p>
					<h2 id="sleepover-title">{content.activities.sleepover.title}</h2>
				</div>
				<p>{content.activities.sleepover.description}</p>
			</div>
			<ActivityImagePlaceholder
				content={content}
				label={content.activities.sleepover.image}
				variant="dark"
				className="sleepover__feature-image"
			/>
		</div>
	</div>

	<div class="sleepover__details">
		<div class="activities-container">
			<div class="sleepover__story-grid">
				<div class="sleepover__story">
					<p class="activities-eyebrow">
						{content.activities.sleepover.storyEyebrow}
					</p>
					<h3>
						{content.activities.sleepover.storyTitle[0]}<br />{
							content.activities.sleepover.storyTitle[1]
						}
					</h3>
					<p>{content.activities.sleepover.story}</p>
					<blockquote>{content.activities.sleepover.quote}</blockquote>
				</div>
				<div class="sleepover__included">
					<h3>{content.activities.sleepover.includedTitle}</h3>
					<p>{content.activities.sleepover.included}</p>
					<ul>
						<li>{content.activities.sleepover.includedItems[0]}</li>
						<li>{content.activities.sleepover.includedItems[1]}</li>
						<li>{content.activities.sleepover.includedItems[2]}</li>
						<li>{content.activities.sleepover.includedItems[3]}</li>
					</ul>
				</div>
			</div>

			<div class="sleepover__gallery" aria-labelledby="sleepover-gallery-title">
				<div class="sleepover__gallery-heading">
					<h3 id="sleepover-gallery-title">
						{content.activities.sleepover.galleryTitle}
					</h3>
					<span class="activities-eyebrow"
						>{content.activities.sleepover.galleryEyebrow}</span
					>
				</div>
				<div class="sleepover__gallery-track">
					<ActivityImagePlaceholder
						content={content}
						label={content.activities.sleepover.galleryImages[0]}
					/>
					<ActivityImagePlaceholder
						content={content}
						label={content.activities.sleepover.galleryImages[1]}
						variant="dark"
					/>
					<ActivityImagePlaceholder
						content={content}
						label={content.activities.sleepover.galleryImages[2]}
					/>
				</div>
			</div>

			<div class="sleepover__extension">
				<div>
					<p class="activities-eyebrow">
						{content.activities.sleepover.extensionEyebrow}
					</p>
					<h3>{content.activities.sleepover.extensionTitle}</h3>
					<p>{content.activities.sleepover.extension}</p>
				</div>
				<ActivityImagePlaceholder
					content={content}
					label={content.activities.sleepover.extensionImage}
					variant="dark"
				/>
			</div>

			<div class="sleepover__practical">
				<div class="activities-section-head">
					<div>
						<p class="activities-eyebrow">
							{content.activities.sleepover.practicalEyebrow}
						</p>
						<h3>{content.activities.sleepover.practicalTitle}</h3>
					</div>
					<p>{content.activities.sleepover.practical}</p>
				</div>
				<dl>
					<div>
						<dt>{content.activities.sleepover.facts[0].label}</dt><dd>
							{content.activities.sleepover.facts[0].value}
						</dd>
					</div>
					<div>
						<dt>{content.activities.sleepover.facts[1].label}</dt><dd>
							{content.activities.sleepover.facts[1].value}
						</dd>
					</div>
					<div>
						<dt>{content.activities.sleepover.facts[2].label}</dt><dd>
							{content.activities.sleepover.facts[2].value}
						</dd>
					</div>
					<div>
						<dt>{content.activities.sleepover.facts[3].label}</dt><dd>
							{content.activities.sleepover.facts[3].value}
						</dd>
					</div>
				</dl>
			</div>

			<div class="sleepover__enquiry">
				<div>
					<h3>{content.activities.sleepover.enquiryTitle}</h3>
					<p>{content.activities.sleepover.enquiry}</p>
				</div>
				<a class="button button--small" href="#consulta-actividades"
					>{content.shared.nav.direct}</a
				>
			</div>
		</div>
	</div>
</section>
