---
import type { SiteContent } from '../../i18n';
interface Props {
	content: SiteContent;
}
import ActivityImagePlaceholder from './ActivityImagePlaceholder.astro';
const { content } = Astro.props;

const rentals = content.activities.rentals.items;
---

<section
	class="activities-rentals activities-container"
	aria-labelledby="rentals-title"
>
	<div class="activities-section-head">
		<div>
			<p class="activities-eyebrow">{content.activities.rentals.eyebrow}</p>
			<h2 id="rentals-title">
				{content.activities.rentals.title[0]}<br />{
					content.activities.rentals.title[1]
				}
			</h2>
		</div>
		<p>{content.activities.rentals.description}</p>
	</div>
	<div class="activities-rentals__grid">
		{
			rentals.map((rental, index) => (
				<article class="rental-card">
					<div class="rental-card__heading">
						<h3>{rental.name}</h3>
						<span>{String(index + 1).padStart(2, '0')}</span>
					</div>
					<ActivityImagePlaceholder content={content} label={rental.image} />
					<div class="rental-card__bottom">
						<p>{content.activities.rentals.pending}</p>
						<a href="#consulta-actividades">
							{content.activities.rentals.ask} <span aria-hidden="true">→</span>
						</a>
					</div>
				</article>
			))
		}
	</div>
</section>
