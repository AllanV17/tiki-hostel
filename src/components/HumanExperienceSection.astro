---
import type { SiteContent } from '../i18n';
interface Props {
	content: SiteContent;
}
import { Image } from 'astro:assets';
import welcomeImage from '../assets/home/bienvenida-hostal.webp';
const { content } = Astro.props;
---

<section
	class="human-experience section-space"
	id="experiencia"
	aria-labelledby="experience-title"
>
	<div class="human-experience__inner container">
		<Image
			src={welcomeImage}
			format={welcomeImage.format}
			widths={[480, 768, 1080]}
			sizes="(max-width: 820px) 100vw, 50vw"
			alt={content.home.experience.imageAlt}
			class="home-photo human-experience__photo"
			loading="lazy"
			data-reveal="in"
		/>
		<div class="human-experience__copy provisional-copy">
			<div class="section-heading" data-reveal="up">
				<p class="eyebrow eyebrow--terracotta">
					{content.home.experience.eyebrow}
				</p>
				<h2 class="section-title" id="experience-title">
					{content.home.experience.title}
				</h2>
			</div>
			<div class="human-experience__body" data-reveal="up">
				<p>{content.home.experience.paragraphs[0]}</p>
				<p>{content.home.experience.paragraphs[1]}</p>
			</div>
		</div>
	</div>
</section>
