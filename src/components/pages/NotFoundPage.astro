---
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import { getContent, type Language } from '../../i18n';
import { getLocalizedHref } from '../../i18n/routes';

interface Props { language: Language }
const { language } = Astro.props;
const content = getContent(language);
const text = content.notFound;
---

<div data-not-found-view data-language={language} data-title={text.meta.title}
	data-description={text.meta.description} data-skip-label={content.shared.nav.skipToContent}>
	<SiteHeader content={content} language={language} variant="light" activePage={null} />
	<main id="main-content" tabindex="-1" class="not-found">
		<p class="not-found__eyebrow">{text.eyebrow}</p>
		<div class="not-found__landscape" aria-hidden="true">
			<span class="not-found__number">404</span>
			<svg class="not-found__trail" viewBox="0 0 880 230" fill="none" focusable="false" aria-hidden="true">
				<g stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
					<path opacity=".7" d="M18 126C44 125 60 103 83 66Q88 56 94 66C128 114 137 126 190 126M692 135C727 135 737 94 770 94C798 94 812 135 866 135" />
					<path d="M18 130C97 128 142 131 186 164S253 212 316 212H402M444 212C483 212 504 236 542 229S600 177 635 177C678 177 689 206 744 206H874" />
					<circle cx="18" cy="130" r="3" fill="var(--color-paper)" />
					<circle cx="874" cy="206" r="3" fill="currentColor" />
				</g>
			</svg>
		</div>
		<h1>{text.heading}</h1>
		<p class="not-found__description">{text.description}<br />{text.reassurance}</p>
		<a class="button not-found__home" href={getLocalizedHref('home', language)}>{text.home}</a>
		<noscript><p class="not-found__fallback"><a href={getLocalizedHref('home', 'en')} lang="en">{getContent('en').notFound.home}</a></p></noscript>
	</main>
	<SiteFooter content={content} language={language} activePage={null} />
</div>

<style>
	.not-found { padding: 38px 24px 48px; text-align: center; }
	.not-found__eyebrow { color: var(--color-terracotta-text); font-size: 11px; font-weight: 600; text-transform: uppercase; }
	.not-found__landscape { position: relative; width: min(880px, 100%); height: auto; aspect-ratio: 880 / 220; margin: 26px auto 22px; }
	.not-found__number { display: block; font-family: var(--font-display); font-size: clamp(110px, 24vw, 248px); font-weight: 400; line-height: .95; letter-spacing: -.065em; padding-right: .065em; }
	.not-found__trail { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; color: var(--color-terracotta); }
	.not-found h1 { max-width: 1100px; margin-inline: auto; font-family: var(--font-display); font-size: clamp(2rem, 3.1vw, 2.75rem); font-weight: 400; line-height: 1.2; letter-spacing: -.025em; text-wrap: balance; }
	.not-found__description { margin-top: 20px; color: #68635d; font-size: 16px; line-height: 1.65; text-wrap: pretty; }
	.not-found__home { margin-top: 30px; }
	.not-found__fallback { margin-top: 20px; }
	@media (max-width: 820px) {
		.not-found { padding: 36px 24px 52px; }
		.not-found__landscape { margin-block: 34px 26px; }
		.not-found__number { font-size: 29.5vw; }
		.not-found h1 { max-width: 680px; }
	}
	@media (max-width: 560px) {
		.not-found { padding-inline: 22px; }
		.not-found__landscape { width: 100%; aspect-ratio: 880 / 300; }
		.not-found__number { font-size: 36vw; }
		.not-found__trail { top: 20px; }
		.not-found__description { font-size: 15px; }
	}
</style>
