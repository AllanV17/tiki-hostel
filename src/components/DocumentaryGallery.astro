---
import type { SiteContent } from '../i18n';
interface Props {
	content: SiteContent;
}
import { Image } from 'astro:assets';
import sharedLifeImage from '../assets/home/vida-compartida.jpg';
import hostelDetailImage from '../assets/home/detalle-hostal.webp';
import landscapeImage from '../assets/home/paisaje-ometepe.jpg';
import forestImage from '../assets/home/bosque-al-aire-libre.jpg';
const { content } = Astro.props;

const images = [sharedLifeImage, hostelDetailImage, landscapeImage, forestImage];
---

<section
	class="gallery section-space"
	id="galeria"
	aria-labelledby="gallery-title"
>
	<div class="container">
		<div class="gallery__heading" data-reveal="up">
			<h2 class="section-title" id="gallery-title">
				{content.home.gallery.title}
			</h2>
			<p class="eyebrow eyebrow--terracotta">{content.home.gallery.hashtag}</p>
		</div>
		<div class="gallery-grid" aria-label={content.home.gallery.label} data-reveal="in">
			{
				images.map((image, index) => (
					<Image
						src={image}
						format={image.format}
						width={640}
						widths={[320, 640]}
						sizes="(max-width: 820px) 50vw, 25vw"
						alt={content.home.gallery.imageAlts[index]}
						class="home-photo gallery-grid__item"
						loading="lazy"
					/>
				))
			}
		</div>
	</div>
</section>
