---
import type { SiteContent } from '../i18n';
interface Props {
	content: SiteContent;
}
import MediaPlaceholder from './MediaPlaceholder.astro';
const { content } = Astro.props;

const variants = ['olive', 'clay', 'stone', 'olive'] as const;
---

<section
	class="gallery section-space"
	id="galeria"
	aria-labelledby="gallery-title"
>
	<div class="container">
		<div class="gallery__heading">
			<h2 class="section-title" id="gallery-title">
				{content.home.gallery.title}
			</h2>
			<p class="eyebrow eyebrow--terracotta">{content.home.gallery.hashtag}</p>
		</div>
		<div class="gallery-grid" aria-label={content.home.gallery.label}>
			{
				content.home.gallery.moments.map((moment, index) => (
					<MediaPlaceholder
						content={content}
						label={moment}
						variant={variants[index]}
						className="gallery-grid__item"
					/>
				))
			}
		</div>
	</div>
</section>
