---
import type { SiteContent } from '../i18n';
interface Props {
	content: SiteContent;
}
import { Image } from 'astro:assets';
import architectureImage from '../assets/home/arquitectura-hostal.jpg';
import madera from '../assets/madera.png';
import treePineIcon from '../assets/icons/tree-pine.svg?url';
import houseIcon from '../assets/icons/house.svg?url';
const { content } = Astro.props;
---

<section
	class="architecture section-space"
	id="arquitectura"
	aria-labelledby="architecture-title"
>
	<div class="architecture__inner container">
		<div class="architecture__copy">
			<div class="section-heading" data-reveal="up">
				<p class="eyebrow eyebrow--terracotta">
					{content.home.architecture.eyebrow}
				</p>
				<h2 class="section-title" id="architecture-title">
					{content.home.architecture.title}
				</h2>
			</div>
			<div class="provisional-copy architecture__body" data-reveal="up">
				<p>{content.home.architecture.paragraphs[0]}</p>
				<p>{content.home.architecture.paragraphs[1]}</p>
			</div>
			<ul
				class="architecture__features provisional-copy"
				aria-label={content.home.architecture.featuresLabel}
			>
				<li>
					<img
						class="feature-icon"
						src={treePineIcon}
						width="20"
						height="20"
						alt=""
					/>{content.home.architecture.features[0]}
				</li>
				<li>
					<img
						class="feature-icon"
						src={houseIcon}
						width="20"
						height="20"
						alt=""
					/>{content.home.architecture.features[1]}
				</li>
			</ul>
		</div>

		<div class="architecture__visual">
			<Image
				src={architectureImage}
				format={architectureImage.format}
				widths={[480, 768, 1024]}
				sizes="(max-width: 820px) 100vw, 50vw"
				alt={content.home.architecture.imageAlt}
				class="home-photo architecture__photo"
				loading="lazy"
				data-reveal="in"
			/>
			<div class="architecture__caption" data-reveal="up">
				<blockquote class="provisional-copy">
					<p>{content.home.architecture.quote}</p>
				</blockquote>
				<Image
					src={madera}
					alt={content.home.architecture.detailAlt}
					class="architecture__detail"
					loading="lazy"
				/>
			</div>
		</div>
	</div>
</section>
