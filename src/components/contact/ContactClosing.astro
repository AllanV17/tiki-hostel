---
import type { SiteContent } from '../../i18n';
interface Props {
	content: SiteContent;
}
const { content } = Astro.props;
---

<section class="contact-closing" aria-label={content.contact.closing.label}>
	<div class="contact-container" data-reveal="up">
		<p class="contact-closing__message">{content.contact.closing.text}</p>
		<p>{content.contact.closing.secondary}</p>
	</div>
</section>
