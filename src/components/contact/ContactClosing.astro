---
import type { SiteContent } from '../../i18n';
interface Props {
	content: SiteContent;
}
const { content } = Astro.props;
---

<section class="contact-closing" aria-label={content.contact.closing.label}>
	<div class="contact-container">
		<p>{content.contact.closing.text}</p>
	</div>
</section>
