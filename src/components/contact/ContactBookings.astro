---
import type { SiteContent } from '../../i18n';
interface Props {
	content: SiteContent;
}
const { content } = Astro.props;
import { bookingUrl } from '../../config/external-links';
---

<div class="contact-connect__group" id="reservas" data-reveal="up">
	<h3><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M7 3v4M17 3v4M3 11h18m-12 5 2 2 4-4" /></svg>{content.contact.bookings.title}</h3>
	<p>{content.contact.bookings.description}</p>
	<ul class="contact-connect__links">
		<li>
			<span class="contact-connect__pending">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 11.5a8 8 0 0 1-8 8 9 9 0 0 1-3.5-.7L4 20l1.2-4.5a9 9 0 0 1-.7-3.5 8 8 0 0 1 15.5-.5Z M8 11.5h8 M8 15h5" /></svg>
				<span>{content.contact.bookings.direct}</span>
			</span>
		</li>
		<li>
			<a href={bookingUrl} target="_blank" rel="noopener noreferrer" aria-label={content.contact.bookings.bookingLabel}>
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 18v3 M21 18v3 M3 18h18v-6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6Z M5 10V5h14v5 M8 8h2 M14 8h2" /></svg>
				<span>Booking.com</span><span class="contact-connect__arrow" aria-hidden="true">↗</span>
			</a>
		</li>
	</ul>
</div>
