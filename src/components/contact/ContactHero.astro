---
import type { SiteContent } from '../../i18n';
interface Props {
	content: SiteContent;
}
const { content } = Astro.props;
---

<section class="contact-hero contact-container" aria-labelledby="contact-title">
	<p class="contact-eyebrow">{content.contact.hero.eyebrow}</p>
	<div class="contact-hero__intro">
		<h1 id="contact-title">{content.contact.hero.title}</h1>
		<p>{content.contact.hero.description}</p>
	</div>
</section>
