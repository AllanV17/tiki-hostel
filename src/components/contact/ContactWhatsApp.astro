---
import type { SiteContent } from '../../i18n';
interface Props {
	content: SiteContent;
}
const { content } = Astro.props;
---

<section
	class="contact-whatsapp"
	id="whatsapp"
	aria-labelledby="contact-whatsapp-title"
>
	<div class="contact-container contact-whatsapp__inner">
		<div>
			<p class="contact-eyebrow">{content.contact.whatsapp.eyebrow}</p>
			<h2 id="contact-whatsapp-title">{content.contact.whatsapp.title}</h2>
			<p>{content.contact.whatsapp.description}</p>
		</div>
		<!-- WhatsApp URL is pending client confirmation. -->
		<a
			class="button"
			href="#whatsapp"
			data-link-placeholder
			aria-label={content.contact.whatsapp.buttonLabel}
			>{content.contact.whatsapp.button}</a
		>
	</div>
</section>
