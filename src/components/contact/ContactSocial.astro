---
import type { SiteContent } from '../../i18n';
const { content } = Astro.props;
interface Props {
	content: SiteContent;
}
const networks = content.contact.social.networks;
---

<section
	class="contact-social"
	id="redes"
	aria-labelledby="contact-social-title"
>
	<div class="contact-container">
		<div class="contact-section-heading">
			<p class="contact-eyebrow">{content.contact.social.eyebrow}</p>
			<h2 id="contact-social-title">{content.contact.social.title}</h2>
		</div>
		<ul class="contact-social__list">
			<!-- Each social profile needs its confirmed external URL. -->
			{
				networks.map((network) => (
					<li>
						<div>
							<>
								<h3>{network.name}</h3>
								<p>{network.note}</p>
							</>
						</div>
						<a
							href="#redes"
							data-link-placeholder
							aria-label={`${network.name}; ${content.contact.social.profilePending}`}
						>
							{content.contact.social.visit} <span aria-hidden="true">↗</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
